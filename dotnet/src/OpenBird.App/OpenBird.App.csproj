<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>OpenBird.App</RootNamespace>
    <AssemblyName>OpenBird</AssemblyName>
    <Version>3.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app that carries the Windows App SDK with it: no separate runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Build for the machine's own architecture unless one is given (dotnet build -r win-x64). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\openbird.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\OpenBird.Core\OpenBird.Core.csproj" />
    <ProjectReference Include="..\OpenBird.Speech\OpenBird.Speech.csproj" />
    <ProjectReference Include="..\OpenBird.Windows\OpenBird.Windows.csproj" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- On a non-Windows build machine the XAML compiler does not run. This stand-in for its
       generated code lets the C# be type-checked there; it is never used in a real build. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Include="CompileCheckShim.cs.txt" Link="CompileCheckShim.cs" />
  </ItemGroup>

</Project>
